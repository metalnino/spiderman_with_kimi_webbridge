{
  "defaults": {
    "trial_keywords": ["绿植租摆", "花卉租摆"],
    "delay_ms_min": 800,
    "delay_ms_max": 2200,
    "max_pages_per_keyword": 1,
    "entry": "python scripts/jobs/run_incremental.py",
    "list_page": "python scripts/jobs/build_incremental_list.py → data/web/incremental.html"
  },
  "ccgp": {
    "enabled": true,
    "name": "中国政府采购网",
    "list_url": "https://search.ccgp.gov.cn/bxsearch",
    "time_type": "5",
    "detail": "http",
    "rate_limit_note": "易频繁访问；失败记 crawl_runs"
  },
  "ggzy": {
    "enabled": true,
    "name": "全国公共资源交易平台",
    "api": "https://www.ggzy.gov.cn/information/pubTradingInfo/getTradList",
    "deal_time": "05",
    "referer": "https://www.ggzy.gov.cn/deal/dealList.html",
    "fetch_detail": false,
    "captcha_policy": "stop_keyword_on_829"
  },
  "chinabidding": {
    "enabled": true,
    "name": "中国采购与招标网",
    "list_api": "https://www.chinabidding.com.cn/sdbxinfo/313035392e302e7379675f62616e64/datax/json/info_search",
    "detail_host": "https://www.chinabidding.cn",
    "mode": "list_only",
    "rp": 15
  },
  "cebpub": {
    "enabled": true,
    "name": "中国招标投标公共服务平台",
    "list_url": "https://bulletin.cebpubservice.com/xxfbcmses/search/bulletin.html",
    "note": "P0 全国词检索；详情验证码后置"
  },
  "jsggzy": {
    "enabled": true,
    "name": "江苏省公共资源交易网",
    "home": "http://jsggzy.jszwfw.gov.cn/",
    "list_page": "http://jsggzy.jszwfw.gov.cn/jyxx/tradeInfonew.html",
    "search_api": "http://jsggzy.jszwfw.gov.cn/inteligentsearch/rest/esinteligentsearch/getFullTextDataNew",
    "note": "主路径：全国ggzy+DEAL_PROVINCE=320000；辅路径省站API（证书不稳时跳过）"
  },
  "chinabidding_detail": {
    "cookie_env": "CHINABIDDING_COOKIE",
    "note": "未配置 Cookie 时仅列表；配置后可尝试详情字段"
  },
  "jiangsu_zhaobiao": {
    "enabled": true,
    "name": "江苏招标网",
    "home": "https://jiangsu.zhaobiao.cn/",
    "search_api": "https://jiangsu.zhaobiao.cn/psearch/Dqsearch",
    "login_page": "https://user.zhaobiao.cn/login.html",
    "login_required": true,
    "cred_env": ["JIANGSU_ZHAOBIAO_USER", "JIANGSU_ZHAOBIAO_PASS"],
    "note": "列表可匿名；登录含滑块验证码，失败则 captcha_todos + Cookie 回灌"
  }
}
