MYSQL_HOST=your_nas.synology.me
MYSQL_PORT=3306
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=spiderman_bids
MYSQL_CHARSET=utf8mb4

# 可选：采招网登录后 Cookie，用于详情字段（无则 list_only）
CHINABIDDING_COOKIE=

# 江苏招标网账号（登录含滑块；列表可匿名，Cookie 回灌后详情更稳）
JIANGSU_ZHAOBIAO_USER=
JIANGSU_ZHAOBIAO_PASS=

# Docker/NAS 台账（compose 里也会覆盖）
# LEDGER_HOST=0.0.0.0
# LEDGER_PORT=8765
# TZ=Asia/Shanghai
# CRAWL_CRON_HOURS=8,12,18,22
# CRAWL_ON_START=0

# 邮件验证码回传闭环（瑞达恒登录，详见 .cursor/docs/rccchina_email_auth.md）
# GMAIL_USER=your@gmail.com            # Gmail 账号（需开启 IMAP；应用专用密码）
# GMAIL_APP_PASSWORD=16位应用专用密码   # 不进 git
# RCCCHINA_PHONE=13800000000           # 瑞达恒登录手机号（短信发到此号码）
# EMAIL_TO=279152260@qq.com            # 收请求邮件/回复验证码的邮箱（默认 qq）
# EMAIL_PROXY=http://127.0.0.1:63009   # 可选：Gmail 走代理隧道（国内直连不稳）
