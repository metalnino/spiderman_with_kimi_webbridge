MYSQL_HOST=your_nas.synology.me
MYSQL_PORT=3306
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=spiderman_bids
MYSQL_CHARSET=utf8mb4

# 可选：采招网登录后 Cookie，用于详情字段（无则 list_only）
CHINABIDDING_COOKIE=

# 江苏招标网账号（登录含滑块；列表可匿名，Cookie 回灌后详情更稳）
JIANGSU_ZHAOBIAO_USER=
JIANGSU_ZHAOBIAO_PASS=

# Docker/NAS 台账（compose 里也会覆盖）
# LEDGER_HOST=0.0.0.0
# LEDGER_PORT=8765
# CRAWL_INTERVAL_HOURS=2
# CRAWL_ON_START=0
