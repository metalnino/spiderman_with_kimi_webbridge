.env
.env.local
.cursor/mcp.local.json
__pycache__/
*.pyc
.venv/
venv/
*.log
.DS_Store

# 本地爬取样本与探针缓存（体积大、含动态数据）
data/trial/
data/trial_multi/
data/crm/
data/chinabidding/
data/multi_site/
data/data/
# 列表页可本地生成；不强制提交大数据
data/web/*.json
# 运行时再生成的缓存/日志（每次爬取都会变，不入库）
data/web/crm.html
data/web/dashboard.html
data/web/warm_log.jsonl
# P7 水位文件（本机运行时状态，每轮更新，不入库）
data/watermark/
# 临时探针脚本与样本（调试残留，勿入库）
scripts/_tmp_*
data/web/zhaobiao_*
# 人工划码回灌的 Cookie（勿提交）
data/sessions/

# DSH 运行态目录（harness 会话状态，非项目内容）
.dsh/

# OCR API 密钥（勿提交）
config/ocr_api.json

# 员工采集员运行时产物（每次运行覆写，不入库）
reports/
data/collector/*.txt
data/collector_out_*.json
data/web/webbridge_server.log
data/web/webbridge_server.pid

# 官方 kimi-webbridge daemon 下载产物（cdk.kimi.com，不入库）
data/web/kimi-webbridge.exe
data/web/kimi_install.ps1

# P6 管道交接物（运行时产物，每轮出勤覆写/归档；消费者读磁盘不读 git）
handoffs/

# 保留目录占位可改用 .gitkeep；当前整目录忽略

downloads/
